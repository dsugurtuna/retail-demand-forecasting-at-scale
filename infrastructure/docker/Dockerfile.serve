# API image. Mount a model directory written by `python -m src.train` at
# /app/models/model, for example artefacts/smoke/model.
#   docker build -f infrastructure/docker/Dockerfile.serve -t forecasting-api .
#   docker run --rm -p 8000:8000 -v "$PWD/artefacts/smoke/model:/app/models/model:ro" forecasting-api
# Not built in CI yet. See README for what the API can and cannot do.

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir ".[serve]"

RUN useradd --create-home --uid 1000 forecasting
USER forecasting

ENV PYTHONUNBUFFERED=1 \
    FORECAST_MODEL_PATH=/app/models/model

EXPOSE 8000

# /live answers whenever the process serves requests; /ready needs a model.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/live')"

CMD ["uvicorn", "src.serving.api:app", "--host", "0.0.0.0", "--port", "8000"]
