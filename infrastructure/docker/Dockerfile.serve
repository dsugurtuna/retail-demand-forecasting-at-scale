# =============================================================================
# Serving Image
# =============================================================================
# Optimized for low-latency inference
# Production-ready with health checks and security hardening
# =============================================================================

# Build stage
FROM python:3.11-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (serving only)
COPY pyproject.toml ./
RUN pip install --no-cache-dir \
    fastapi>=0.109.0 \
    uvicorn[standard]>=0.27.0 \
    pydantic>=2.5.0 \
    numpy>=1.26.0 \
    pandas>=2.1.0 \
    lightgbm>=4.0.0 \
    joblib>=1.3.0 \
    structlog>=24.1.0

# =============================================================================
# Production stage
# =============================================================================
FROM python:3.11-slim as production

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r forecasting && useradd -r -g forecasting forecasting

# Copy Python packages
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin/uvicorn /usr/local/bin/uvicorn

# Copy application code
COPY src/serving/ ./src/serving/
COPY src/models/ ./src/models/
COPY src/utils/ ./src/utils/

# Create directories for models
RUN mkdir -p /app/models && chown -R forecasting:forecasting /app

USER forecasting

# Environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV FORECAST_ENVIRONMENT=production
ENV FORECAST_SERVING_HOST=0.0.0.0
ENV FORECAST_SERVING_PORT=8000

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run uvicorn
CMD ["uvicorn", "src.serving.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
